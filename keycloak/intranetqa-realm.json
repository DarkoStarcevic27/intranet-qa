{
  "realm": "intranetqa",
  "enabled": true,
  "sslRequired": "none",
  "accessTokenLifespan": 3600,
  "roles": {
    "realm": [
      { "name": "uploader", "description": "Can upload and index documents" },
      { "name": "admin", "description": "Full access" },
      { "name": "user", "description": "Can ask questions in chat" }
    ]
  },
  "groups": [
    { "name": "engineering" },
    { "name": "finance" },
    { "name": "public" }
  ],
  "clients": [
    {
      "clientId": "intranet-qa",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:8080/*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "document-groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "document_groups",
            "full.path": "false",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice-engineering",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Engineer",
      "email": "alice@example.com",
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["user", "uploader"],
      "groups": ["engineering", "public"]
    },
    {
      "username": "bob-finance",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Finance",
      "email": "bob@example.com",
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["user"],
      "groups": ["finance", "public"]
    },
    {
      "username": "carol-admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Admin",
      "email": "carol@example.com",
      "credentials": [{ "type": "password", "value": "password", "temporary": false }],
      "realmRoles": ["user", "uploader", "admin"],
      "groups": ["engineering", "finance", "public"]
    }
  ]
}